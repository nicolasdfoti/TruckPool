@page "/envios"
@using TruckPool.Models
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>TruckPool - Envíos</PageTitle>

<div class="add-package-container">
    <button class="add-package-btn" @onclick="ShowModal">
        + Agregar Paquete
    </button>
</div>

@if (IsModalOpen)
{
    <div class="modal-overlay @(IsModalClosing ? "closing" : null)" @onclick="CloseModalAsync">
        <div class="modal-content @(IsModalClosing ? "closing" : null)"
             role="dialog"
             aria-modal="true"
             aria-labelledby="modal-title"
             @onclick:stopPropagation="true">

            <h2 id="modal-title">Nuevo paquete</h2>

            <EditForm class="modal-form" Model="newLoad" OnValidSubmit="AddLoad">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <label for="package">
                    Ingresá el paquete:
                    <InputText id="package" @bind-Value="newLoad.Package" placeholder="Ingresá tu paquete" />
                </label>

                <label for="origin">
                    Ingresá el origen:
                    <InputText id="origin" @bind-Value="newLoad.Origin" placeholder="Ingresá el origen" />
                </label>

                <label for="destiny">
                    Ingresá el destino:
                    <InputText id="destiny" @bind-Value="newLoad.Destiny" placeholder="Ingresá el destino" />
                </label>

                <label for="measurements">
                    Ingresá las medidas:
                    <InputText id="measurements" @bind-Value="newLoad.Measures" placeholder="Ingresá las medidas" />
                </label>

                <label for="date">
                    Ingresá la fecha de entrega:
                    <InputDate id="date" @bind-Value="newLoad.Date" />
                </label>

                <div class="modal-actions">
                    <button class="home-btn" type="submit">Ingresar Paquete</button>
                    <button type="button" class="cancel-btn" @onclick="CloseModalAsync">Cancelar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (LoadList.Count == 0)
{
    <div class="empty-list">
        <p>Tu lista de paquetes está vacía, ¡ingresá algunos!</p>
        <button class="home-btn" @onclick="ShowModal">
            Hacer un envío
        </button>
    </div>
}
else
{
    <h2>Lista de tus paquetes:</h2>
    <table class="shipping-table">
        <thead>
            <tr>
                <th>ID del envío</th>
                <th>Paquete</th>
                <th>Fecha de entrega</th>
                <th>Trucker a cargo</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var load in LoadList)
            {
                <tr>
                    <td>
                        <NavLink class="load-link" href="@($"/envios/{load.LoadId}")" title="Ver detalle">
                            @load.LoadId
                        </NavLink>
                    </td>
                    <td>@load.Package</td>
                    <td>@load.Date.ToString("dd/MM/yyyy")</td>
                    <td>Diego Díaz</td>
                    <td>@load.Status</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    bool IsModalOpen = false;
    bool IsModalClosing = false;

    void ShowModal()
    {
        IsModalClosing = false;
        IsModalOpen = true;
    }

    async Task CloseModalAsync()
    {
        IsModalClosing = true;
        StateHasChanged();
        await Task.Delay(220);
        IsModalOpen = false;
        IsModalClosing = false;
    }

    Load newLoad = new()
    {
        Date = DateTime.Today,
        Status = "En progreso"
    };

    List<Load> LoadList = new();

    async Task AddLoad()
    {
        newLoad.LoadId = Guid.NewGuid();
        LoadList.Add(newLoad);

        newLoad = new Load
        {
            Date = DateTime.Today,
            Status = "En progreso"
        };

        await CloseModalAsync();
    }
}

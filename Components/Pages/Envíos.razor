@page "/envíos"
@using TruckPool.Models
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>TruckPool - Envíos</PageTitle>

<div class="form-wrapper">
    <EditForm class="login-form" Model="newLoad" OnValidSubmit="AddLoad">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <fieldset>
            <legend>Llená tus datos:</legend>
        </fieldset>

        <label for="">
            Ingresá el paquete:
            <InputText @bind-Value="newLoad.Package" placeholder="Ingresá tu paquete" />
        </label>

        <label for="">
            Ingresá el origen:
            <InputText @bind-Value="newLoad.Origin" placeholder="Ingresá el origen" />
        </label>

        <label for="">
            Ingresá el destino:
            <InputText @bind-Value="newLoad.Destiny" placeholder="Ingresá el destino" />
        </label>

        <label for="">
            Ingresá las medidas:
            <InputText @bind-Value="newLoad.Measures" placeholder="Ingresá las medidas" />
        </label>

        <label for="">
            Ingresá la fecha de entrega:
            <InputDate @bind-Value="newLoad.Date" />
        </label>

        <button class="home-btn" type="submit">Ingresar Paquete</button>
    </EditForm>
</div>

@if (LoadList.Count == 0)
{
    <div class="empty-list">
        <p>Tu lista de paquetes está vacía, ¡ingresá algunos!</p>
    </div>
}
else
{   
    <h2>Lista de tus paquetes:</h2>
    <div class="load-grid">

        @foreach (var load in LoadList)
        {
            <div class="load-container">
                <h2>@load.Package</h2>
                <p>Para ser enviado a @load.Destiny el @load.Date.ToString("dd/MM/yyyy")</p>
                <p>Status: @load.Status</p>
            </div>
        }
    </div>
}

@code {
    Load newLoad = new()
    {
        Date = DateTime.Today,
        Status = "En progreso"
    };

    List<Load> LoadList = new();

    void AddLoad()
    {
        newLoad.LoadId = Guid.NewGuid();

        LoadList.Add(newLoad);

        newLoad = new Load
        {
            Date = DateTime.Today,
            Status = "En progreso"
        };
    }
}
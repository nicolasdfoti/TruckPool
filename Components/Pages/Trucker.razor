@page "/trucker"
@using TruckPool.Models
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>TruckPool - Ser Trucker</PageTitle>

<div class="form-wrapper">

    <div class="login-container">
        <EditForm class="login-form" Model="newDriver">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <fieldset>
                <legend>Carga tus datos:</legend>
            </fieldset>

            <label for="">
                Ingresá tu nombre
                <InputText @bind-Value="@newDriver.Name" placeholder="Ingresá tu nombre"/>
            </label>

            <label for="">
                Ingresá tu email
                <InputText @bind-Value="@newDriver.Email" placeholder="Ingresá tu email"/>
            </label>

            <label for="">
                Ingresá dónde vivís/trabajas
                <InputText @bind-Value="@newDriver.Location" placeholder="Ingresá tu locación"/>
            </label>

            <label for="">
                Ingresá tu rol (fletero/dueño de compañía)
                <InputText @bind-Value="@newDriver.Role" placeholder="Ingresá tu rol"/>
            </label>

            <button class="home-btn" type="submit">Ser Trucker</button>
        </EditForm>
    </div>

    <div class="login-link">
    <p>
        ¿Ya sos Trucker?
        <NavLink href="/iniciar-sesión">
            Iniciá sesión
        </NavLink>
    </p>
</div>
</div>

@code {
    Driver newDriver = new() {
        DriverId = Guid.NewGuid()
    };
}